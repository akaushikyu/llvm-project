# Test target:
#   Targets termination classification with two distinct LR sites. The first LR
#   must produce exact paths for "SC Match", "LR Self", "Another LR", and
#   "RETURN"; the second LR must produce exact "SC Match" and "RETURN" paths.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_multiple_termination_types.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_multiple_termination_types.before-bnerd.mir -o lrsc_multiple_termination_types.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/mir-output.txt
# RUN: cat %t/lrsc_multiple_termination_types.after-expand-count.mir >> %t/mir-output.txt
# RUN: echo __MIR_EOF__ >> %t/mir-output.txt
# RUN: FileCheck %s --check-prefix=MIR --strict-whitespace < %t/mir-output.txt
# RUN: echo __JSON_BOF__ > %t/json-output.txt
# RUN: cat %t/lrsc_multiple_termination_types.before-bnerd.mir.lrscStats.json >> %t/json-output.txt
# RUN: echo __JSON_EOF__ >> %t/json-output.txt
# RUN: FileCheck %s --check-prefix=JSON --strict-whitespace < %t/json-output.txt
#
# Exact coverage:
#   First LR: SC Match, LR Self, Another LR, RETURN
#   Second LR: SC Match, RETURN

