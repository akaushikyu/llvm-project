  bb.1:
    PseudoRET

  bb.2:
    PseudoRET
...

# CHECK-LABEL: name: after_lr_bltu
# CHECK:       $x13 = LR_D $x10
# CHECK-NEXT:  $x14 = SLTU $x11, $x12
# CHECK-NEXT:  BNE $x14, $x0, %bb.2
# CHECK-NOT:   PseudoBLTUUsingBNE


# ============================================================================
# PseudoBGEUUsingBNE after LR
# ============================================================================

---
name: after_lr_bgeu
tracksRegLiveness: true
selected: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10, $x11, $x12

    $x13 = LR_D $x10
    dead early-clobber $x14 = PseudoBGEUUsingBNE $x11, $x12, %bb.2

