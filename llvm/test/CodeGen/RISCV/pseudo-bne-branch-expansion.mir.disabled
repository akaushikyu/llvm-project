# CHECK-NEXT:  $x14 = SLTU $x11, $x12
# CHECK-NEXT:  BNE $x14, $x0, %bb.1
# CHECK-NEXT:  PseudoBR %bb.2
# CHECK-NOT:   PseudoBGEUUsingBNE


# ============================================================================
# Pseudos NOT after an LR
#
# They must simply turn back into their original RISC-V branch.
# ============================================================================

---
name: non_lr_beq
tracksRegLiveness: true
selected: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x11, $x12

    dead early-clobber $x14 = PseudoBEQUsingBNE $x11, $x12, %bb.2

  bb.1:
    PseudoRET

  bb.2:
    PseudoRET
...

# CHECK-LABEL: name: non_lr_beq
# CHECK:       BEQ $x11, $x12, %bb.2
# CHECK-NOT:   PseudoBEQUsingBNE


---
name: non_lr_blt
tracksRegLiveness: true
selected: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x11, $x12

    dead early-clobber $x14 = PseudoBLTUsingBNE $x11, $x12, %bb.2

