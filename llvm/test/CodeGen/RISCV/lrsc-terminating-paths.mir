# RUN: rm -f %s.lrscStats.json
# RUN: rm -rf %t && mkdir -p %t
# RUN: cd %t && llc -mtriple=riscv64 -mattr=+a \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -verify-machineinstrs \
# RUN:   -dump-insn-stats-json \
# RUN:   %s -o after-expand-count.mir 2> llc.log
# RUN: FileCheck %s --check-prefix=IR < %t/after-expand-count.mir
# RUN: FileCheck %s --check-prefix=MIR < %t/after-expand-count.mir
# RUN: cat %s.lrscStats.json | FileCheck %s --check-prefix=JSON-TOTALS
# RUN: cat %s.lrscStats.json | FileCheck %s --check-prefix=JSON-PATHS
# RUN: cat %s.lrscStats.json | FileCheck %s --check-prefix=JSON-CAUSES
# RUN: cat %s.lrscStats.json | FileCheck %s --check-prefix=JSON-LOOPS
# RUN: rm -f %s.lrscStats.json

# IR-DAG: atomicrmw add ptr @amo_sink32
# IR-DAG: atomicrmw xchg ptr @amo_sink32

# MIR-DAG: LR_W
# MIR-DAG: SC_W
# MIR-DAG: LR_W_AQ
# MIR: PseudoRET

# JSON-TOTALS: "lrsc_fail_two_termination_paths"
# JSON-TOTALS: "total_loop_seq_conditional_lrsc_occurrences":
# JSON-TOTALS: "total_loop_seq_unconditional_lrsc_occurrences":
# JSON-TOTALS: "total_lrsc_occurrences":

# JSON-PATHS: "lr_paths"
# JSON-PATHS: "terminating_paths"

# JSON-CAUSES-DAG: "cause": "SC Match"
# JSON-CAUSES-DAG: "cause": "RETURN"
# JSON-CAUSES-DAG: "cause": "LR Self"

# JSON-LOOPS-DAG: "numberOfLoops":
# JSON-LOOPS-DAG: "cycle_flavour": "LRSC"
# JSON-LOOPS-DAG: "cycle_flavour": "LR"
# JSON-LOOPS-DAG: "cycle_flavour": "NORMAL"

