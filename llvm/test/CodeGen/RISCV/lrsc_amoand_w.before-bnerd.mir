# Test target:
#   Targets lowering of one atomicrmw and operation to its exact
#   LR_W/SC_W machine sequence when ZAAMO is disabled. The original
#   synthetic LR path must terminate at the generated LR as "Another LR", and
#   the complete emitted MIR and LR/SC JSON statistics must match exactly.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_amoand_w.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_amoand_w.before-bnerd.mir -o lrsc_amoand_w.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/mir-output.txt
# RUN: cat %t/lrsc_amoand_w.after-expand-count.mir >> %t/mir-output.txt
# RUN: echo __MIR_EOF__ >> %t/mir-output.txt
# RUN: FileCheck %s --check-prefix=MIR --strict-whitespace < %t/mir-output.txt
# RUN: echo __JSON_BOF__ > %t/json-output.txt
# RUN: cat %t/lrsc_amoand_w.before-bnerd.mir.lrscStats.json >> %t/json-output.txt
# RUN: echo __JSON_EOF__ >> %t/json-output.txt
# RUN: FileCheck %s --check-prefix=JSON --strict-whitespace < %t/json-output.txt
#


