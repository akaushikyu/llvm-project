  target triple = "riscv64-unknown-unknown-elf"
  
  @zaamo_value = dso_local global i32 0, align 4
  @zaamo_result_sink = dso_local global i64 0, align 8
  
  ; Function Attrs: noinline nounwind optnone
  define dso_local signext i32 @lrsc_amoand_w(ptr noundef %0, i32 noundef signext %1, i32 noundef signext %2, i32 noundef signext %3) #0 {
    %5 = alloca i32, align 4
    %6 = alloca ptr, align 8
    %7 = alloca i32, align 4
    %8 = alloca i32, align 4
    %9 = alloca i32, align 4
    %10 = alloca i32, align 4
    %11 = alloca i32, align 4
    %12 = alloca i32, align 4
    %13 = alloca i32, align 4
    %14 = alloca i32, align 4
    store ptr %0, ptr %6, align 8
    store i32 %1, ptr %7, align 4
    store i32 %2, ptr %8, align 4
    store i32 %3, ptr %9, align 4
    %15 = load ptr, ptr %6, align 8
    %16 = load i32, ptr %7, align 4
    %17 = load i32, ptr %8, align 4
    %18 = call { i32, i32 } asm sideeffect "0:\0A\09lr.w $0, ($2)\0A\09bne $0, $3, 1f\0A\09sc.w $1, $4, ($2)\0A\09bnez $1, 0b\0A\091:\0A\09", "=&r,=&r,r,r,r,~{memory}"(ptr %15, i32 %16, i32 %17) #1, !srcloc !5
    %19 = extractvalue { i32, i32 } %18, 0
    %20 = extractvalue { i32, i32 } %18, 1
    store i32 %19, ptr %10, align 4
    store i32 %20, ptr %11, align 4
    %21 = load i32, ptr %10, align 4
    %22 = load i32, ptr %7, align 4
    %23 = icmp eq i32 %21, %22
    br i1 %23, label %24, label %29
  
  24:                                               ; preds = %4
    %25 = load i32, ptr %11, align 4
    %26 = icmp eq i32 %25, 0
    %27 = zext i1 %26 to i64
    %28 = select i1 %26, i32 0, i32 -2
    store i32 %28, ptr %5, align 4
    br label %41
  
  29:                                               ; preds = %4
    %30 = load i32, ptr %9, align 4
    %31 = icmp ne i32 %30, 0
    br i1 %31, label %33, label %32
  
  32:                                               ; preds = %29
    store i32 -1, ptr %5, align 4
    br label %41
  
  33:                                               ; preds = %29
    store i32 255, ptr %13, align 4
    %34 = load i32, ptr %13, align 4
    %35 = atomicrmw and ptr @zaamo_value, i32 %34 acquire, align 4
    store i32 %35, ptr %14, align 4
    %36 = load i32, ptr %14, align 4
    store i32 %36, ptr %12, align 4
    %37 = load i32, ptr %12, align 4
    %38 = zext i32 %37 to i64
    %39 = load volatile i64, ptr @zaamo_result_sink, align 8
    %40 = add i64 %39, %38
    store volatile i64 %40, ptr @zaamo_result_sink, align 8
    store i32 -3, ptr %5, align 4
    br label %41
  
  41:                                               ; preds = %33, %32, %24
