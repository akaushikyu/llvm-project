# Test target:
#   Targets a comparison-failure path that branches back to a block preceding
#   the original LR. The traversal must record the terminating path as "LR Self"
#   and record the statistics for the terminating path.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_loop_back_before_lr.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_loop_back_before_lr.before-bnerd.mir -o lrsc_loop_back_before_lr.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/lrsc_loop_back_before_lr.mir.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_loop_back_before_lr.after-expand-count.mir >> %t/lrsc_loop_back_before_lr.mir.check
# RUN: echo __MIR_EOF__ >> %t/lrsc_loop_back_before_lr.mir.check
# RUN: FileCheck %s --check-prefix=MIR --match-full-lines < %t/lrsc_loop_back_before_lr.mir.check
# RUN: echo __JSON_BOF__ > %t/lrsc_loop_back_before_lr.json.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_loop_back_before_lr.before-bnerd.mir.lrscStats.json >> %t/lrsc_loop_back_before_lr.json.check
# RUN: echo __JSON_EOF__ >> %t/lrsc_loop_back_before_lr.json.check
# RUN: FileCheck %s --check-prefix=JSON --match-full-lines < %t/lrsc_loop_back_before_lr.json.check
#


