  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.3):
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x10, $x11, $x12, $x1
  
    $x2 = frame-setup ADDI $x2, -48
    frame-setup SD killed $x1, $x2, 40 :: (store (s64) into %stack.6)
    frame-setup SD killed $x8, $x2, 32 :: (store (s64) into %stack.7)
    $x8 = frame-setup ADDI $x2, 48
    SD killed renamable $x10, $x8, -32 :: (store (s64) into %ir.5)
    SW killed renamable $x11, $x8, -36 :: (store (s32) into %ir.6)
    SW killed renamable $x12, $x8, -40 :: (store (s32) into %ir.7)
    renamable $x10 = LD $x8, -32 :: (dereferenceable load (s64) from %ir.5)
    renamable $x11 = LW $x8, -40 :: (dereferenceable load (s32) from %ir.7)
    renamable $x12 = LW $x8, -36 :: (dereferenceable load (s32) from %ir.6)
    INLINEASM &"0:\0A\09lr.w $0, ($2)\0A\09bne $0, $3, 1f\0A\09sc.w $1, $4, ($2)\0A\09bnez $1, 0b\0A\091:\0A\09", 25 /* sideeffect mayload maystore attdialect */, 720907 /* regdef-ec:GPRNoX0 */, def early-clobber renamable $x13, 720907 /* regdef-ec:GPRNoX0 */, def early-clobber renamable $x14, 720905 /* reguse:GPRNoX0 */, killed renamable $x10, 720905 /* reguse:GPRNoX0 */, killed renamable $x12, 720905 /* reguse:GPRNoX0 */, killed renamable $x11, !5
    SW killed renamable $x13, $x8, -44 :: (store (s32) into %ir.8)
    SW killed renamable $x14, $x8, -48 :: (store (s32) into %ir.9)
    renamable $x10 = LW $x8, -44 :: (dereferenceable load (s32) from %ir.8)
    renamable $x11 = LW $x8, -36 :: (dereferenceable load (s32) from %ir.6)
    BEQ killed renamable $x10, killed renamable $x11, %bb.2
    PseudoBR %bb.1
  
  bb.1 (%ir-block.19):
    successors: %bb.5(0x80000000)
  
    renamable $x10 = ADDI $x0, -1
    SW killed renamable $x10, $x8, -20 :: (store (s32) into %ir.4)
    PseudoBR %bb.5
  
  bb.2 (%ir-block.20):
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
  
    renamable $x10 = LW $x8, -48 :: (dereferenceable load (s32) from %ir.9)
    BEQ killed renamable $x10, $x0, %bb.4
    PseudoBR %bb.3
  
  bb.3 (%ir-block.23):
    successors: %bb.5(0x80000000)
  
    renamable $x10 = ADDI $x0, -2
    SW killed renamable $x10, $x8, -20 :: (store (s32) into %ir.4)
    PseudoBR %bb.5
  
  bb.4 (%ir-block.24):
    successors: %bb.5(0x80000000)
  
    SW $x0, $x8, -20 :: (store (s32) into %ir.4)
    PseudoBR %bb.5
  
  bb.5 (%ir-block.25):
    renamable $x10 = LW $x8, -20 :: (dereferenceable load (s32) from %ir.4)
    $x1 = frame-destroy LD $x2, 40 :: (load (s64) from %stack.6)
    $x8 = frame-destroy LD $x2, 32 :: (load (s64) from %stack.7)
    $x2 = frame-destroy ADDI $x2, 48
    PseudoRET implicit $x10
...
