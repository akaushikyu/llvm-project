--- |
  ; ModuleID = '/home/akamran/Desktop/LIT/seperated/lrsc_basic_inline_asm_expansion.bc'
  source_filename = "lrsc_basic_inline_asm_expansion.c"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64-unknown-unknown-elf"
  
  ; Function Attrs: noinline nounwind optnone
  define dso_local signext i32 @lrsc_basic_inline_asm_expansion(ptr noundef %0, i32 noundef signext %1, i32 noundef signext %2) #0 {
    %4 = alloca i32, align 4
    %5 = alloca ptr, align 8
    %6 = alloca i32, align 4
    %7 = alloca i32, align 4
    %8 = alloca i32, align 4
    %9 = alloca i32, align 4
    store ptr %0, ptr %5, align 8
    store i32 %1, ptr %6, align 4
    store i32 %2, ptr %7, align 4
    %10 = load ptr, ptr %5, align 8
    %11 = load i32, ptr %6, align 4
    %12 = load i32, ptr %7, align 4
    %13 = call { i32, i32 } asm sideeffect "0:\0A\09lr.w $0, ($2)\0A\09bne $0, $3, 1f\0A\09sc.w $1, $4, ($2)\0A\09bnez $1, 0b\0A\091:\0A\09", "=&r,=&r,r,r,r,~{memory}"(ptr %10, i32 %11, i32 %12) #1, !srcloc !5
    %14 = extractvalue { i32, i32 } %13, 0
    %15 = extractvalue { i32, i32 } %13, 1
    store i32 %14, ptr %8, align 4
    store i32 %15, ptr %9, align 4
    %16 = load i32, ptr %8, align 4
    %17 = load i32, ptr %6, align 4
    %18 = icmp ne i32 %16, %17
    br i1 %18, label %19, label %20
  
  19:                                               ; preds = %3
    store i32 -1, ptr %4, align 4
    br label %25
  
  20:                                               ; preds = %3
    %21 = load i32, ptr %9, align 4
    %22 = icmp ne i32 %21, 0
    br i1 %22, label %23, label %24
  
  23:                                               ; preds = %20
    store i32 -2, ptr %4, align 4
    br label %25
  
  24:                                               ; preds = %20
    store i32 0, ptr %4, align 4
    br label %25
  
  25:                                               ; preds = %24, %23, %19
    %26 = load i32, ptr %4, align 4
    ret i32 %26
  }
  
  attributes #0 = { noinline nounwind optnone "frame-pointer"="all" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="generic-rv64" "target-features"="+64bit,+a,+m,+relax,+zicsr,+zifencei,-c,-d,-e,-experimental-zacas,-experimental-zcmop,-experimental-zfbfmin,-experimental-zicfilp,-experimental-zicfiss,-experimental-zimop,-experimental-ztso,-experimental-zvfbfmin,-experimental-zvfbfwma,-f,-h,-smaia,-smepmp,-ssaia,-svinval,-svnapot,-svpbmt,-v,-xcvalu,-xcvbi,-xcvbitmanip,-xcvelw,-xcvmac,-xcvmem,-xcvsimd,-xsfvcp,-xsfvfnrclipxfqf,-xsfvfwmaccqqq,-xsfvqmaccdod,-xsfvqmaccqoq,-xtheadba,-xtheadbb,-xtheadbs,-xtheadcmo,-xtheadcondmov,-xtheadfmemidx,-xtheadmac,-xtheadmemidx,-xtheadmempair,-xtheadsync,-xtheadvdot,-xventanacondops,-za128rs,-za64rs,-zawrs,-zba,-zbb,-zbc,-zbkb,-zbkc,-zbkx,-zbs,-zca,-zcb,-zcd,-zce,-zcf,-zcmp,-zcmt,-zdinx,-zfa,-zfh,-zfhmin,-zfinx,-zhinx,-zhinxmin,-zic64b,-zicbom,-zicbop,-zicboz,-ziccamoa,-ziccif,-zicclsm,-ziccrse,-zicntr,-zicond,-zihintntl,-zihintpause,-zihpm,-zk,-zkn,-zknd,-zkne,-zknh,-zkr,-zks,-zksed,-zksh,-zkt,-zmmul,-zvbb,-zvbc,-zve32f,-zve32x,-zve64d,-zve64f,-zve64x,-zvfh,-zvfhmin,-zvkb,-zvkg,-zvkn,-zvknc,-zvkned,-zvkng,-zvknha,-zvknhb,-zvks,-zvksc,-zvksed,-zvksg,-zvksh,-zvkt,-zvl1024b,-zvl128b,-zvl16384b,-zvl2048b,-zvl256b,-zvl32768b,-zvl32b,-zvl4096b,-zvl512b,-zvl64b,-zvl65536b,-zvl8192b,+a,-zaamo" }
  attributes #1 = { nounwind }
  
  !llvm.module.flags = !{!0, !1, !2, !3}
  !llvm.ident = !{!4}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 1, !"target-abi", !"lp64"}
  !2 = !{i32 7, !"frame-pointer", i32 2}
  !3 = !{i32 8, !"SmallDataLimit", i32 8}
  !4 = !{!"Ubuntu clang version 18.1.3 (1ubuntu1)"}
  !5 = !{i64 338, i64 343, i64 369, i64 396, i64 426, i64 450, i64 465}
