# Test target:
#   Targets expansion of one LR/SC compare-and-retry INLINEASM into the exact
#   machine CFG and opcodes expected by riscv-expand-inline-asm. It also checks
#   that riscv-count-lr-sc reports the resulting LR/SC pair and its exact paths.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_basic_inline_asm_expansion.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_basic_inline_asm_expansion.before-bnerd.mir -o lrsc_basic_inline_asm_expansion.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/lrsc_basic_inline_asm_expansion.mir.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_basic_inline_asm_expansion.after-expand-count.mir >> %t/lrsc_basic_inline_asm_expansion.mir.check
# RUN: echo __MIR_EOF__ >> %t/lrsc_basic_inline_asm_expansion.mir.check
# RUN: FileCheck %s --check-prefix=MIR --match-full-lines < %t/lrsc_basic_inline_asm_expansion.mir.check
# RUN: echo __JSON_BOF__ > %t/lrsc_basic_inline_asm_expansion.json.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_basic_inline_asm_expansion.before-bnerd.mir.lrscStats.json >> %t/lrsc_basic_inline_asm_expansion.json.check
# RUN: echo __JSON_EOF__ >> %t/lrsc_basic_inline_asm_expansion.json.check
# RUN: FileCheck %s --check-prefix=JSON --match-full-lines < %t/lrsc_basic_inline_asm_expansion.json.check
#


