# Test target:
#   Targets canonicalization and deduplication of one multi-block cycle that can
#   be entered and discovered from different blocks. Rotated descriptions of the
#   same cycle must produce one canonical NORMAL-loop entry and not duplicates.
#   For instance: 5 → 6 → 8 → 9 → 5,
#                 6 → 8 → 9 → 5 → 6 and 
#                 8 → 9 → 5 → 6 → 8 
#   are all the same cycle and should not be double-counted.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_cycle_canonicalization.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_cycle_canonicalization.before-bnerd.mir -o lrsc_cycle_canonicalization.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/lrsc_cycle_canonicalization.mir.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_cycle_canonicalization.after-expand-count.mir >> %t/lrsc_cycle_canonicalization.mir.check
# RUN: echo __MIR_EOF__ >> %t/lrsc_cycle_canonicalization.mir.check
# RUN: FileCheck %s --check-prefix=MIR --match-full-lines < %t/lrsc_cycle_canonicalization.mir.check
# RUN: echo __JSON_BOF__ > %t/lrsc_cycle_canonicalization.json.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_cycle_canonicalization.before-bnerd.mir.lrscStats.json >> %t/lrsc_cycle_canonicalization.json.check
# RUN: echo __JSON_EOF__ >> %t/lrsc_cycle_canonicalization.json.check
# RUN: FileCheck %s --check-prefix=JSON --match-full-lines < %t/lrsc_cycle_canonicalization.json.check
#


