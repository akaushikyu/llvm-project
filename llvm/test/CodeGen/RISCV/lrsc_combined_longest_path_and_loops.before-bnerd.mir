# Test target:
#   Targets the combined behaviors that require competing paths from one LR:
#   longest-path selection, path-specific loop attachment, exact loop counts,
#   and reattachment of discovered loops to the correct terminating path.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_combined_longest_path_and_loops.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_combined_longest_path_and_loops.before-bnerd.mir -o lrsc_combined_longest_path_and_loops.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/lrsc_combined_longest_path_and_loops.mir.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_combined_longest_path_and_loops.after-expand-count.mir >> %t/lrsc_combined_longest_path_and_loops.mir.check
# RUN: echo __MIR_EOF__ >> %t/lrsc_combined_longest_path_and_loops.mir.check
# RUN: FileCheck %s --check-prefix=MIR --match-full-lines < %t/lrsc_combined_longest_path_and_loops.mir.check
# RUN: echo __JSON_BOF__ > %t/lrsc_combined_longest_path_and_loops.json.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_combined_longest_path_and_loops.before-bnerd.mir.lrscStats.json >> %t/lrsc_combined_longest_path_and_loops.json.check
# RUN: echo __JSON_EOF__ >> %t/lrsc_combined_longest_path_and_loops.json.check
# RUN: FileCheck %s --check-prefix=JSON --match-full-lines < %t/lrsc_combined_longest_path_and_loops.json.check
#


