--- |
  ; ModuleID = '/home/akamran/Desktop/LIT/seperated/lrsc_combined_longest_path_and_loops.bc'
  source_filename = "lrsc_combined_longest_path_and_loops.c"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64-unknown-unknown-elf"
  
  @combined_sink = dso_local global i32 0, align 4
  
  ; Function Attrs: noinline nounwind optnone
  define dso_local signext i32 @lrsc_combined_longest_path_and_loops(ptr noundef %0, i32 noundef signext %1, i32 noundef signext %2, i32 noundef signext %3) #0 {
    %5 = alloca i32, align 4
    %6 = alloca ptr, align 8
    %7 = alloca i32, align 4
    %8 = alloca i32, align 4
    %9 = alloca i32, align 4
    %10 = alloca i32, align 4
    %11 = alloca i32, align 4
    %12 = alloca i32, align 4
    %13 = alloca i32, align 4
    %14 = alloca i32, align 4
    %15 = alloca i32, align 4
    %16 = alloca i32, align 4
    %17 = alloca i32, align 4
    %18 = alloca i32, align 4
    %19 = alloca i32, align 4
    %20 = alloca i32, align 4
    %21 = alloca i32, align 4
    %22 = alloca i32, align 4
    store ptr %0, ptr %6, align 8
    store i32 %1, ptr %7, align 4
    store i32 %2, ptr %8, align 4
    store i32 %3, ptr %9, align 4
    %23 = load ptr, ptr %6, align 8
    %24 = load i32, ptr %7, align 4
    %25 = load i32, ptr %8, align 4
    %26 = call { i32, i32 } asm sideeffect "0:\0A\09lr.w $0, ($2)\0A\09bne $0, $3, 1f\0A\09sc.w $1, $4, ($2)\0A\09bnez $1, 0b\0A\091:\0A\09", "=&r,=&r,r,r,r,~{memory}"(ptr %23, i32 %24, i32 %25) #1, !srcloc !5
    %27 = extractvalue { i32, i32 } %26, 0
    %28 = extractvalue { i32, i32 } %26, 1
    store i32 %27, ptr %10, align 4
    store i32 %28, ptr %11, align 4
    %29 = load i32, ptr %10, align 4
    %30 = load i32, ptr %7, align 4
    %31 = icmp eq i32 %29, %30
    br i1 %31, label %32, label %37
  
  32:                                               ; preds = %4
    %33 = load i32, ptr %11, align 4
    %34 = icmp eq i32 %33, 0
    %35 = zext i1 %34 to i64
    %36 = select i1 %34, i32 0, i32 -4
    store i32 %36, ptr %5, align 4
    br label %204
  
