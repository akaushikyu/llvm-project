# Test target:
#   Targets discovery of connected outer, inner, and deeper nested NORMAL cycles
#   on an LR terminating path. It checks the exact canonical loop paths, loop
#   instruction counts, total number of loops, and path attachment.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/lrsc_nested_loop_discovery.before-bnerd.mir
# RUN: cd %t && llc -mtriple=riscv64-unknown-elf \
# RUN:   -run-pass=riscv-expand-inline-asm,riscv-count-lr-sc \
# RUN:   -dump-insn-stats-json -verify-machineinstrs \
# RUN:   lrsc_nested_loop_discovery.before-bnerd.mir -o lrsc_nested_loop_discovery.after-expand-count.mir
# RUN: echo __MIR_BOF__ > %t/lrsc_nested_loop_discovery.mir.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_nested_loop_discovery.after-expand-count.mir >> %t/lrsc_nested_loop_discovery.mir.check
# RUN: echo __MIR_EOF__ >> %t/lrsc_nested_loop_discovery.mir.check
# RUN: FileCheck %s --check-prefix=MIR --match-full-lines < %t/lrsc_nested_loop_discovery.mir.check
# RUN: echo __JSON_BOF__ > %t/lrsc_nested_loop_discovery.json.check
# RUN: sed '/^[[:space:]]*$/d' %t/lrsc_nested_loop_discovery.before-bnerd.mir.lrscStats.json >> %t/lrsc_nested_loop_discovery.json.check
# RUN: echo __JSON_EOF__ >> %t/lrsc_nested_loop_discovery.json.check
# RUN: FileCheck %s --check-prefix=JSON --match-full-lines < %t/lrsc_nested_loop_discovery.json.check
#

