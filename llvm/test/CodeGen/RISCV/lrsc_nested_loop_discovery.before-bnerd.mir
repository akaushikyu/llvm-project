    br i1 %56, label %57, label %58
  
  57:                                               ; preds = %52
    br label %29
  
  58:                                               ; preds = %52
    br label %59
  
  59:                                               ; preds = %58
    store i32 -1, ptr %4, align 4
    br label %60
  
  60:                                               ; preds = %59, %22
    %61 = load i32, ptr %4, align 4
    ret i32 %61
  }
  
