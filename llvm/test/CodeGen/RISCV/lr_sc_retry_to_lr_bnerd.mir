# RUN: llc \
# RUN:   -mtriple=riscv64-linux-gnu \
# RUN:   -mattr=+m,+a,+f,+d,+c,+bnerd,-zaamo \
# RUN:   -riscv-run-bnerd \
# RUN:   -verify-machineinstrs \
# RUN:   -dump-insn-stats-json \
# RUN:   -filetype=asm -asm-verbose=false %s -o - \
# RUN:   | FileCheck %s

# REQUIRES: riscv-registered-target

--- |
  define void @retry_to_lr_bnerd() {
  entry:
    ret void
  }
...
---
name: retry_to_lr_bnerd
tracksRegLiveness: true
selected: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: gpr }
  - { id: 5, class: gpr }
body: |
  bb.0:
    successors: %bb.1
    liveins: $x10, $x11, $x14, $x15
    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x14
    %3:gpr = COPY $x15

  bb.1:
    successors: %bb.1, %bb.2
    %4:gpr = LR_D %0
    BNE %2, %3, %bb.1

  bb.2:
    successors: %bb.1, %bb.3
    %5:gpr = SC_D %1, %0
    BNE %5, $x0, %bb.1

  bb.3:
    PseudoRET
...

# CHECK-LABEL: retry_to_lr_bnerd:
# CHECK:       lr.d
# CHECK-NEXT:  bnerd
# CHECK:       sc.d
# CHECK-NEXT:  bne
# CHECK:       ret
# CHECK:       sc.w
# CHECK:       j